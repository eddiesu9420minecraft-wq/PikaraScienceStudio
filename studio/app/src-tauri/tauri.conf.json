{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pikara Science Studio",
  "mainBinaryName": "PikaraScienceStudio",
  "version": "0.3.2",
  "identifier": "com.pikara.science.studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Pikara Science Studio",
        "url": "splash.html",
        "width": 560,
        "height": 340,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "main",
        "visible": false,
        "title": "Pikara Science Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pikara Science contributors",
    "copyright": "Copyright (c) 2026 Pikara Science contributors (MIT)",
    "shortDescription": "Pikara Science Studio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
